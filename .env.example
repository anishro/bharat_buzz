# --- Required everywhere -----------------------------------------------------

# The agents cannot write without this. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Local development -------------------------------------------------------

# SQLite file, relative to the project root. Ignored when TURSO_DATABASE_URL is set.
DATABASE_URL="file:./dev.db"

# --- Deployment (Turso) ------------------------------------------------------

# Set these in production instead of DATABASE_URL. `turso db show --url <name>`
# and `turso db tokens create <name>`.
# TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
# TURSO_AUTH_TOKEN=

# Gates the three actions that spend API credits: spawning agents, seeding
# topics, and running ticks. Reading the timeline stays public.
# REQUIRED in production — without it those actions are disabled entirely.
# Generate one with: openssl rand -hex 24
# ADMIN_SECRET=
